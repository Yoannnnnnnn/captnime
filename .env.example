# ============================================================
# Captnime — konfigurasi sumber data & panel admin
# ============================================================
# Salin file ini menjadi .env.local lalu sesuaikan.

# local    = katalog demo bawaan (default, tanpa konfigurasi)
# database = SQLite lokal yang dikelola lewat /admin
# remote   = API JSON milik Anda sendiri (docs/INTEGRASI-SUMBER-DATA.md)
CAPTNIME_DATA_SOURCE=local

# --- mode remote ---
CAPTNIME_API_BASE_URL=
CAPTNIME_API_KEY=

# Interval revalidasi cache data (detik)
CAPTNIME_REVALIDATE=60

# --- mode database (lihat docs/DATABASE.md) ---
CAPTNIME_DB_PATH=
CAPTNIME_DATA_DIR=
CAPTNIME_SCHEMA_PATH=

# --- metadata (docs/METADATA.md) ---
# Default https://graphql.anilist.co — ganti bila perlu proxy/mock.
CAPTNIME_ANILIST_ENDPOINT=

# --- video (docs/VIDEO.md) ---
# Awalan CDN untuk path relatif, mis. https://media.contoh.com
# Dengan ini pindah dari berkas lokal ke R2/Bunny cukup ganti nilai ini.
CAPTNIME_MEDIA_BASE_URL=

# --- unggahan berkas (docs/VIDEO.md) ---
# Folder berkas unggahan (di luar public/). Default: data/uploads
CAPTNIME_UPLOAD_DIR=
# Batas ukuran per berkas (MB). Harus ≤ bodySizeLimit di next.config.ts (512 MB).
CAPTNIME_UPLOAD_MAX_MB=512
# Secret tanda tangan tautan media. Kosong → memakai CAPTNIME_ADMIN_SECRET/password.
# Isi nilai acak panjang di server publik agar tautan tidak bisa dibuat orang lain.
CAPTNIME_MEDIA_SECRET=

# --- panel admin (/admin) ---
# WAJIB diganti sebelum dipasang di server publik.
CAPTNIME_ADMIN_PASSWORD=
# Kunci penanda tangan cookie sesi; bila kosong memakai password di atas.
CAPTNIME_ADMIN_SECRET=

# --- email transaksional (docs/EMAIL.md) ---
# Nilai contoh seperti "xxxx"/"ganti-..." DITOLAK sebagai belum dikonfigurasi.
# Periksa tanpa membuka aplikasi: npm run cek-email -- --dry
# Mailjet Send API v3.1. Biarkan kosong untuk mematikan fitur email: tautan
# verifikasi & reset tidak dikirim, halaman memberi pesan jelas, dan kode
# pemulihan tetap bisa dipakai.
# API Key & Secret Key dari Mailjet (bukan email dan bukan sandi akun).
MJ_APIKEY_PUBLIC=
MJ_APIKEY_PRIVATE=
# Alamat pengirim yang SUDAH divalidasi di Mailjet (Account > Senders & Domains).
CAPTNIME_MAIL_FROM=
CAPTNIME_MAIL_FROM_NAME=Captnime
# Basis URL absolut untuk tautan di dalam email. WAJIB diisi saat produksi,
# mis. https://captnime.id — tanpa ini tautan memakai host permintaan.
CAPTNIME_APP_URL=
# Hanya untuk uji lokal: arahkan ke server tiruan Mailjet.
CAPTNIME_MAILJET_ENDPOINT=
# "1" = aktifkan SandboxMode Mailjet (payload divalidasi, email tidak dikirim).
CAPTNIME_MAIL_SANDBOX=
